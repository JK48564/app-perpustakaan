{
  "info": {
    "name": "App Perpustakaan - Pertemuan 9 API",
    "description": "Koleksi Postman untuk pengujian REST API Pertemuan 9 (books, members, loans, stats)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Books",
      "item": [
        {
          "name": "GET /api/books (Semua Buku)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "GET /api/books (Filter Judul)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books?judul=laskar",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "judul",
                  "value": "laskar"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/books (Filter Category)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books?category_id=1",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "category_id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/books/:id (Detail Buku)",
