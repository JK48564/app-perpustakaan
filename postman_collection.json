            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Bumi Manusia\",\n  \"penulis\": \"Pramoedya Ananta Toer\",\n  \"penerbit\": \"Hasta Mitra\",\n  \"tahun_terbit\": 1980,\n  \"isbn\": \"978-979-973-12-0\",\n  \"stok\": 5,\n  \"category_id\": 2\n}"
